# ─────────────────────────────────────────
# GitLab AI Chatbot — Environment Template
# Copy this to .env and fill in your keys.
# ─────────────────────────────────────────

# Google Gemini API Key (from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Pinecone API Key (from https://app.pinecone.io)
PINECONE_API_KEY=your_pinecone_api_key_here

# Name of your Pinecone index
PINECONE_INDEX_NAME=gitlab-chatbot

# (Optional) Override the frontend API URL for custom deployments
# VITE_API_BASE_URL=https://your-render-app.onrender.com
